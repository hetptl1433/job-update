# Copy to .env.local for local backend development. Never put these values in
# project.yml, Info.plist, Swift source, or an Xcode scheme.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Use sandbox until the entire Link, webhook, disconnect, and data-deletion
# flow has been tested. Change this only with the matching Plaid secret.
PLAID_ENV=sandbox

# Chase OAuth on iOS requires an HTTPS Universal Link owned by this app.
PLAID_REDIRECT_URI=https://your-domain.example/plaid/oauth
PLAID_WEBHOOK_URL=https://your-domain.example/api/plaid/webhook

